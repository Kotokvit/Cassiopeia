## RuneData — Custom Resource for individual rune
class_name RuneData
extends Resource

@export var rune_id: String = ""
@export var rune_name: String = ""
@export var rune_name_en: String = ""
@export var description: String = ""
@export var element: String = ""
@export var base_atf_cost: float = 10.0
@export var echo_generation: float = 3.0
@export var color: Color = Color.WHITE
@export var duration: float = 5.0
@export var effect_type: String = ""
@export var effect_value: float = 1.0
@export var icon_path: String = ""
